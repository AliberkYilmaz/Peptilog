# Peptilog environment variables
# Copy to .env.local (dev), .env.staging, .env.prod — never commit real values.
# Pass to Flutter via: flutter run --dart-define-from-file=.env.local

# Supabase — get from Supabase dashboard: Project Settings > API
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>

# Sentry (optional for local dev)
SENTRY_DSN=

# Environment tag shown in Sentry
ENV=development
